# DM Cockpit Companion – lokale Konfiguration
# Diese Datei kopieren zu .env und dort die echten Werte eintragen.
# .env ist per .gitignore ausgeschlossen und darf nicht committed werden.

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_GM_USER_ID=

# Speech-to-Text
# Standard bleibt "none", damit niemals versehentlich Audio an eine Cloud gesendet wird.
# Für Deepgram: deepgram
STT_PROVIDER=none
DEEPGRAM_API_KEY=
DEEPGRAM_STT_ENDPOINT=wss://api.eu.deepgram.com/v1/listen
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=de
STT_MAX_CONCURRENCY=4
STT_MAX_PENDING=64
STT_MAX_RETRIES=1

# AI/KI-Extraktion
# Standard bleibt "none".
# "mock" = Testprovider, "ollama" = lokale kostenlose KI, "openai" = optionaler Cloud-Adapter.
AI_PROVIDER=none

# Lokale Ollama-KI (kein API-Key erforderlich)
OLLAMA_AI_MODEL=qwen3:4b
OLLAMA_AI_ENDPOINT=http://127.0.0.1:11434/api/chat
OLLAMA_AI_TIMEOUT_MS=60000
OLLAMA_AI_NUM_CTX=8192
OLLAMA_AI_KEEP_ALIVE=10m

# Optionaler OpenAI-Cloud-Adapter
OPENAI_API_KEY=
OPENAI_AI_MODEL=gpt-5-nano
OPENAI_AI_ENDPOINT=https://api.openai.com/v1/responses
OPENAI_AI_TIMEOUT_MS=20000

# Optional: ausführliche Discord-/Voice-/AI-Diagnose
DM_COCKPIT_DISCORD_DEBUG=0
